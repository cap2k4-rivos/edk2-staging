[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = HestErrorSourceStandaloneMm
  FILE_GUID                      = 3ddbebcc-9841-4ef8-87fa-305843c1922d
  MODULE_TYPE                    = MM_STANDALONE
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x00010032
  ENTRY_POINT                    = StandaloneRasGatewayInitialize

[Sources]
  RasGatewayDriverMM.c

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  StandaloneMmPkg/StandaloneMmPkg.dec
  OvmfPkg/OvmfPkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  StandaloneMmDriverEntryPoint
  SampleRasLib

[Protocols]
  gMmHestErrorSourceDescProtocolGuid

[Guids]
  gMmHestGetErrorSourceInfoGuid

[Pcd]
  gUefiOvmfPkgTokenSpaceGuid.PcdRasErrBlockAddr
  gUefiOvmfPkgTokenSpaceGuid.PcdRasErrBlockSize
  
[Depex]
  TRUE
